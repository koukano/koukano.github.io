<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign sitemap_pages = site.pages | sort: "url" %}
{% for p in sitemap_pages %}
  {% if p.url != "/sitemap.xml" and p.url != "/404.html" %}
  <url>
    <loc>https://koukano.github.io{{ p.url | xml_escape }}</loc>
  </url>
  {% endif %}
{% endfor %}
</urlset>
